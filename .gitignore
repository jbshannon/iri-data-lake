# Build artifacts
/target/
**/*.rs.bk
**/*.pdb

# Local development
*.swp
*.swo
.DS_Store
.pi/

# Generated lakehouse output (large)
/data/lake/
!data/lake/.gitkeep
/data/raw/
!data/raw/.gitkeep

# Manifest outputs that may appear outside of /data/lake during local dev
/manifest.jsonl
*.tmp
*.part

# Criterion benchmark output
/criterion/
/benches/target/

# Python: the analytics layer (sql/, scripts/run_sql.py) runs under uv.
# uv writes .venv/.gitignore containing "*" itself, so the 44 MB
# environment already self-ignores; don't delete that file.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Editor
.vscode/
.idea/